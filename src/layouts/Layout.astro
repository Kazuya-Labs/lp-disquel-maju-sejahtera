---
import '../styles/global.css';
import { site } from '../data/site';
import type { Locale } from '../i18n/translations';
import { getTranslation, localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const htmlLang = locale === 'zh' ? 'zh-CN' : locale;
const canonicalUrl = new URL(Astro.url.pathname, site.siteUrl).href;
const ogImageUrl = new URL('/og-image.png', site.siteUrl).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PT. Dysquel Maju Sejahtera" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" hreflang="id" href={localePath('id')} />
    <link rel="alternate" hreflang="en" href={localePath('en')} />
    <link rel="alternate" hreflang="zh-CN" href={localePath('zh')} />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
