---
import { copy } from '../data/copy';
import { brands, site } from '../data/site';

const tickerNames = brands.map((brand) => brand.name);
---

<section id="top" class="border-b-2 border-ink bg-paper">
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-16 sm:px-6 lg:px-8 lg:pt-16 lg:pb-24">
    <div class="flex flex-wrap items-center justify-between gap-3 border-y-2 border-ink py-3 font-mono text-[11px] font-bold uppercase tracking-[0.12em]">
      <span class="flex items-center gap-3">
        <span class="inline-block h-[3px] w-10 bg-accent" aria-hidden="true"></span>
        {copy.hero.overline}
      </span>
      <span class="hidden text-muted sm:inline">{copy.hero.note}</span>
      <span class="text-muted">Jakarta · ID</span>
    </div>

    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] lg:gap-0">
      <div class="relative z-10 lg:pr-10 lg:pt-14">
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
          {copy.hero.eyebrow}
        </p>

        <h1 class="mt-5 font-display text-[clamp(2.75rem,9.5vw,7rem)] uppercase leading-[0.9] tracking-[-0.045em]">
          <span class="block">{copy.hero.titleTop}</span>
          <span class="block">{copy.hero.titleMiddle}</span>
          <span class="block">{copy.hero.titleBottom}<span class="text-accent">.</span></span>
        </h1>

        <p class="mt-8 max-w-xl border-l-4 border-ink pl-5 text-base leading-[1.7] text-muted sm:text-lg">
          {copy.hero.lead}
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href="#products"
            class="border-2 border-ink bg-ink px-6 py-3 text-sm font-bold uppercase tracking-[0.06em] text-paper no-underline transition-colors hover:border-accent hover:bg-accent"
          >
            {copy.hero.primary}
          </a>
          <a
            href="#contact"
            class="border-2 border-ink bg-paper px-6 py-3 text-sm font-bold uppercase tracking-[0.06em] text-ink no-underline transition-colors hover:bg-ink hover:text-paper"
          >
            {copy.hero.secondary}
          </a>
        </div>

        <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
          {copy.hero.note}
        </p>
      </div>

      <figure class="relative z-0 border-2 border-ink bg-ink lg:-ml-12 lg:mt-28">
        <img
          src={site.heroImage}
          alt="Dysquel industrial supply"
          class="aspect-[4/5] w-full object-cover grayscale transition-[filter] duration-200 hover:grayscale-0 lg:aspect-[3/4]"
          loading="eager"
        />
        <figcaption class="flex flex-wrap items-center justify-between gap-3 border-t-2 border-ink bg-ink px-4 py-3 font-mono text-[11px] uppercase tracking-[0.12em] text-paper">
          <span>{copy.hero.caption}</span>
          <span>01 / 04</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<div class="overflow-hidden border-b-2 border-ink bg-ink text-paper" role="region" aria-label={copy.ticker.label}>
  <div class="marquee-track py-3 font-mono text-[11px] font-bold uppercase tracking-[0.14em]">
    {
      [0, 1].map((pass) => (
        <div class="flex shrink-0 items-center" aria-hidden={pass === 1 ? 'true' : undefined}>
          {
            tickerNames.map((name) => (
              <span class="flex items-center whitespace-nowrap pl-8">
                {name}
                <span class="ml-8 text-paper/40" aria-hidden="true">//</span>
              </span>
            ))
          }
        </div>
      ))
    }
  </div>
</div>
