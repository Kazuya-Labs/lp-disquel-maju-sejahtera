---
import { Icon } from 'astro-icon/components';
import { copy } from '../data/copy';
import { clients, type ClientSector } from '../data/site';
import ClientRows from './ClientRows.astro';

const featured = clients.filter((client) => client.featured);

const tabs = [
  { id: 'featured', label: copy.clients.featured },
  { id: 'textile', label: copy.clients.tabs.textile },
  { id: 'food-beverage', label: copy.clients.tabs.foodBeverage },
  { id: 'paper', label: copy.clients.tabs.paper },
  { id: 'hospitality', label: copy.clients.tabs.hospitality },
];

const bySector = (sector: ClientSector) =>
  clients.filter((client) => client.sector === sector);

const initials = (name: string) =>
  name
    .replace(/^(PT|CV)\.\s*/i, '')
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('');

const number = (value: number) => String(value).padStart(2, '0');
---

<section id="clients" class="border-b-2 border-ink bg-paper">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-6 sm:gap-8 lg:grid-cols-[0.3fr_0.7fr] lg:gap-16">
      <div class="reveal" data-reveal>
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
          {copy.clients.overline}
        </p>
        <span class="mt-6 hidden font-display text-[clamp(5rem,14vw,10rem)] leading-[0.8] text-line sm:block" aria-hidden="true">
          03
        </span>
      </div>
      <div class="reveal" data-reveal>
        <h2 class="font-display text-[clamp(2.25rem,6vw,4.5rem)] uppercase leading-none tracking-[-0.03em]">
          {copy.clients.title}
        </h2>
        <p class="mt-6 max-w-2xl text-base leading-[1.7] text-muted sm:text-lg">
          {copy.clients.lead}
        </p>
      </div>
    </div>

    <div
      role="tablist"
      aria-label={copy.clients.title}
      class="mt-10 flex snap-x gap-2 overflow-x-auto pb-1 sm:mt-14"
    >
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            data-view-tab={tab.id}
            aria-controls={`panel-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            class:list={[
              'shrink-0 snap-start border-2 px-4 py-3 font-mono text-[11px] font-bold uppercase tracking-[0.08em] transition-colors sm:py-2',
              index === 0
                ? 'border-ink bg-ink text-paper'
                : 'border-line text-ink hover:border-ink',
            ]}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="mt-8" data-reveal>
      <div
        role="tabpanel"
        id="panel-featured"
        aria-labelledby="tab-featured"
        data-view-panel="featured"
      >
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {
            featured.map((client, index) => (
              <li class="group border-2 border-line bg-paper transition-colors hover:border-ink">
                <div class="flex aspect-[3/2] items-center justify-center border-b-2 border-line bg-surface p-4">
                  {client.logo ? (
                    <img
                      src={client.logo}
                      alt={client.name}
                      class="max-h-14 w-full object-contain grayscale transition-[filter] group-hover:grayscale-0"
                      loading="lazy"
                    />
                  ) : (
                    <span
                      class="font-display text-[clamp(1.75rem,5vw,3rem)] uppercase tracking-[-0.04em] text-muted transition-colors group-hover:text-ink"
                      aria-hidden="true"
                    >
                      {initials(client.name)}
                    </span>
                  )}
                </div>
                <div class="p-4">
                  <span class="font-mono text-[10px] text-muted">{number(index + 1)}</span>
                  <p class="mt-2 text-sm font-bold leading-[1.4]">{client.name}</p>
                  <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.08em] text-muted">
                    {client.location}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      {
        tabs.slice(1).map((tab) => (
          <div
            role="tabpanel"
            id={`panel-${tab.id}`}
            aria-labelledby={`tab-${tab.id}`}
            data-view-panel={tab.id}
            class="hidden"
          >
            <ClientRows items={bySector(tab.id as ClientSector)} />
          </div>
        ))
      }

      <div id="panel-all" data-view-panel="all" class="hidden">
        <ClientRows items={clients} />
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <button
        type="button"
        data-view-all
        data-view-label={copy.clients.viewAll}
        data-hide-label={copy.clients.hideAll}
        aria-controls="panel-all"
        aria-expanded="false"
        class="inline-flex min-h-12 items-center gap-3 border-2 border-ink bg-paper px-5 font-mono text-[11px] font-bold uppercase tracking-[0.08em] transition-colors hover:border-accent hover:bg-accent hover:text-paper"
      >
        <span data-view-all-label>{copy.clients.viewAll}</span>
        <Icon name="lucide:arrow-up-right" size={16} aria-hidden="true" />
      </button>
      <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
        {clients.length} {copy.clients.clientCount}
      </p>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-view-tab]'),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>('[data-view-panel]'),
  );
  const allButton = document.querySelector<HTMLButtonElement>('[data-view-all]');
  const allLabel = document.querySelector<HTMLElement>('[data-view-all-label]');

  if (tabs.length > 0 && panels.length > 0 && allButton && allLabel) {
    const setView = (view: string) => {
      for (const panel of panels) {
        panel.classList.toggle('hidden', panel.dataset.viewPanel !== view);
      }

      for (const tab of tabs) {
        const isActive = tab.dataset.viewTab === view;
        tab.setAttribute('aria-selected', String(isActive));
        tab.classList.toggle('border-ink', isActive);
        tab.classList.toggle('bg-ink', isActive);
        tab.classList.toggle('text-paper', isActive);
        tab.classList.toggle('border-line', !isActive);
        tab.classList.toggle('text-ink', !isActive);
      }
    };

    const setAllOpen = (open: boolean) => {
      setView(open ? 'all' : 'featured');
      allButton.setAttribute('aria-expanded', String(open));
      allLabel.textContent = open
        ? (allButton.dataset.hideLabel ?? '')
        : (allButton.dataset.viewLabel ?? '');
    };

    allButton.addEventListener('click', () => {
      setAllOpen(allButton.getAttribute('aria-expanded') !== 'true');
    });

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        setAllOpen(false);
        setView(tab.dataset.viewTab ?? 'featured');
      });
    }

    setView('featured');
  }
</script>
