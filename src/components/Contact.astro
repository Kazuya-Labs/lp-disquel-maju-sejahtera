---
import { copy } from '../data/copy';
import { sales, site } from '../data/site';

const primaryEmail = site.emails[0];
---

<section id="contact" class="border-b-2 border-ink bg-paper">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="reveal" data-reveal>
      <p class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
        {copy.contact.overline}
      </p>
      <h2 class="mt-3 font-display text-[clamp(2.5rem,8vw,6rem)] uppercase leading-none tracking-[-0.04em]">
        {copy.contact.title}
      </h2>
      <p class="mt-6 max-w-2xl text-base leading-[1.7] text-muted sm:text-lg">
        {copy.contact.lead}
      </p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
          {copy.contact.addressLabel}
        </h3>
        <address class="mt-3 border-l-4 border-ink pl-5 not-italic leading-[1.7]">
          {site.address.map((line) => <span class="block">{line}</span>)}
        </address>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <div>
            <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
              {copy.contact.emailLabel}
            </h3>
            <ul class="mt-3 space-y-1 text-sm">
              {
                site.emails.map((email) => (
                  <li>
                    <a href={`mailto:${email}`} class="break-all underline decoration-line underline-offset-4 hover:decoration-accent">
                      {email}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
              {copy.contact.phoneLabel} / {copy.contact.faxLabel}
            </h3>
            <p class="mt-3 text-sm">
              <a href={`tel:${site.phone.href}`} class="underline decoration-line underline-offset-4 hover:decoration-accent">
                {site.phone.label}
              </a>
            </p>
            <p class="text-sm text-muted">{site.fax.label}</p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`mailto:${primaryEmail}`}
            class="border-2 border-ink bg-ink px-6 py-3 text-sm font-bold uppercase tracking-[0.06em] text-paper no-underline transition-colors hover:border-accent hover:bg-accent"
          >
            {copy.contact.emailCta}
          </a>
          <a
            href={`tel:${site.phone.href}`}
            class="border-2 border-ink bg-paper px-6 py-3 text-sm font-bold uppercase tracking-[0.06em] text-ink no-underline transition-colors hover:bg-ink hover:text-paper"
          >
            {copy.contact.callCta}
          </a>
        </div>
      </div>

      <div>
        <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
          {copy.contact.salesLabel}
        </h3>
        <ul class="mt-3 border-t-2 border-ink">
          {
            sales.map((person) => (
              <li class="group flex flex-wrap items-center justify-between gap-3 border-b-2 border-line py-4 transition-colors hover:bg-ink hover:text-paper">
                <span class="font-display text-lg uppercase">{person.name}</span>
                <span class="flex items-center gap-4 font-mono text-xs">
                  <a href={`tel:${person.phone}`} class="no-underline hover:text-accent">
                    {person.phone}
                  </a>
                  <a
                    href={`https://wa.me/${person.wa}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-2 border-ink bg-paper px-2 py-1 text-ink no-underline transition-colors hover:border-paper hover:bg-paper"
                  >
                    {copy.contact.waCta}
                  </a>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
