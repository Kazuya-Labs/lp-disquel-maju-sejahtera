---
import {
  brands,
  productCategories,
  type ProductCategoryId,
} from '../data/site';
import { copy } from '../data/copy';

const categoryCopy: Record<
  ProductCategoryId,
  { title: string; description: string }
> = {
  'power-supply': copy.catalog.powerSupply,
  'industrial-parts': copy.catalog.industrialParts,
  pneumatic: copy.catalog.pneumatic,
  'igbt-module': copy.catalog.igbtModule,
  'fan-coller' : copy.catalog.fanColler
};

const categories = productCategories.map((category) => ({
  ...category,
  related: brands.filter((brand) =>
    category.relatedBrands?.includes(brand.name),
  ),
}));

const number = (value: number) => String(value).padStart(2, '0');
---

<section id="products" class="border-b-2 border-ink bg-surface">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
    <section id="brands" aria-labelledby="brands-title">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6 sm:mb-12">
        <div class="reveal" data-reveal>
          <p class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
            {copy.products.overline}
          </p>
          <h2 id="brands-title" class="mt-3 font-display text-[clamp(2.25rem,6vw,4.5rem)] uppercase leading-none tracking-[-0.03em]">
            {copy.products.title}
          </h2>
        </div>
        <p class="max-w-md border-l-4 border-accent pl-4 text-sm leading-[1.7] text-muted">
          {copy.products.lead}
        </p>
      </div>

      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          brands.map((brand, index) => (
            <li class="group relative flex min-h-28 items-center justify-center border-2 border-line bg-paper p-5 transition-colors hover:border-ink sm:min-h-32 sm:p-6">
              <span class="absolute left-3 top-3 font-mono text-[10px] text-muted group-hover:text-accent">
                {number(index + 1)}
              </span>
              <img
                src={brand.image}
                alt={brand.name}
                class="max-h-16 w-full object-contain grayscale transition-[filter] duration-200 group-hover:grayscale-0"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
        {copy.products.note}
      </p>
    </section>

    <section
      id="parts"
      aria-labelledby="parts-title"
      class="mt-12 border-t-2 border-ink pt-10 sm:mt-16 sm:pt-12 lg:mt-20 lg:pt-16"
    >
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6 sm:mb-12">
        <div class="reveal" data-reveal>
          <p class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
            {copy.catalog.overline}
          </p>
          <h2 id="parts-title" class="mt-3 font-display text-[clamp(2.25rem,6vw,4.5rem)] uppercase leading-none tracking-[-0.03em]">
            {copy.catalog.title}
          </h2>
        </div>
        <p class="max-w-md border-l-4 border-accent pl-4 text-sm leading-[1.7] text-muted">
          {copy.catalog.lead}
        </p>
      </div>

      <nav aria-label={copy.catalog.title} class="flex snap-x gap-2 overflow-x-auto pb-1">
        {
          categories.map((category, index) => (
            <a
              href={`#${category.id}`}
              data-category-tab={category.id}
              aria-current={index === 0 ? 'location' : undefined}
              class:list={[
                'shrink-0 snap-start border-2 bg-paper px-4 py-3 font-mono text-[11px] font-bold uppercase tracking-[0.08em] no-underline transition-colors sm:py-2',
                index === 0
                  ? 'border-ink bg-ink text-paper'
                  : 'border-line text-ink hover:border-ink',
              ]}
            >
              {number(index + 1)} / {categoryCopy[category.id].title}
            </a>
          ))
        }
      </nav>

      <div class="mt-10 space-y-12 sm:mt-12 sm:space-y-16">
        {
          categories.map((category, index) => (
            <section
              id={category.id}
              data-category-section={category.id}
              class:list={[
                'border-t-2 pt-8',
                index === 0 ? 'border-accent' : 'border-line',
              ]}
            >
              <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                <div>
                  <div class="flex items-baseline gap-4">
                    <span class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
                      {number(index + 1)}
                    </span>
                    <h3 class="font-display text-2xl uppercase tracking-[-0.02em] sm:text-3xl">
                      {categoryCopy[category.id].title}
                    </h3>
                  </div>
                  <p class="mt-2 max-w-xl text-sm leading-[1.7] text-muted">
                    {categoryCopy[category.id].description}
                  </p>
                </div>
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
                  {category.images.length} {copy.catalog.items}
                </span>
              </div>

              <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
                {
                  category.images.map((image, imageIndex) => (
                    <li
                      class:list={[
                        'border-2 border-line bg-paper p-2 transition-colors hover:border-ink sm:p-3',
                        imageIndex % 7 === 0 && 'lg:col-span-2',
                      ]}
                    >
                      <img
                        src={image}
                        alt={`${categoryCopy[category.id].title} ${imageIndex + 1}`}
                        class="aspect-square w-full object-contain grayscale transition-[filter] duration-200 hover:grayscale-0"
                        loading="lazy"
                      />
                    </li>
                  ))
                }
              </ul>

              {
                category.related.length > 0 && (
                  <div class="mt-6 border-t border-dashed border-line pt-4">
                    <p class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
                      {copy.catalog.relatedBrands}
                    </p>
                    <ul class="mt-3 flex flex-wrap gap-3">
                      {
                        category.related.map((brand) => (
                          <li class="flex h-14 w-28 items-center justify-center border-2 border-line bg-paper p-2 transition-colors hover:border-ink">
                            <img
                              src={brand.image}
                              alt={brand.name}
                              class="max-h-10 w-full object-contain grayscale transition-[filter] duration-200 hover:grayscale-0"
                              loading="lazy"
                            />
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                )
              }
            </section>
          ))
        }
      </div>
    </section>
  </div>
</section>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-category-tab]'),
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-category-section]'),
  );

  if (tabs.length > 0 && sections.length > 0) {
    const setActive = (id: string) => {
      for (const tab of tabs) {
        const isActive = tab.dataset.categoryTab === id;
        tab.classList.toggle('border-ink', isActive);
        tab.classList.toggle('bg-ink', isActive);
        tab.classList.toggle('text-paper', isActive);
        tab.classList.toggle('border-line', !isActive);
        tab.classList.toggle('text-ink', !isActive);
        if (isActive) tab.setAttribute('aria-current', 'location');
        else tab.removeAttribute('aria-current');
      }

      for (const section of sections) {
        const isActive = section.dataset.categorySection === id;
        section.classList.toggle('border-accent', isActive);
        section.classList.toggle('border-line', !isActive);
      }
    };

    setActive(sections[0]?.dataset.categorySection ?? '');

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        setActive(tab.dataset.categoryTab ?? '');
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible?.target instanceof HTMLElement) {
          setActive(visible.target.dataset.categorySection ?? '');
        }
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: [0, 0.1, 0.5] },
    );

    for (const section of sections) observer.observe(section);
  }
</script>
