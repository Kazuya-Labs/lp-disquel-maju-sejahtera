---
import { site } from '../data/site';
import type { Locale } from '../i18n/translations';
import { getTranslation, localePath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const links = [
  { href: '#about', label: t.nav.about },
  { href: '#products', label: t.nav.products },
  { href: '#clients', label: t.nav.clients },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="sticky top-0 z-50 border-b-2 border-ink bg-paper">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href={localePath(locale)} class="flex items-center gap-3 no-underline">
      <img src={site.logo} alt="" class="h-11 w-auto" />
      <span class="font-display text-sm uppercase leading-none tracking-tight sm:text-base">
        PT. Dysquel<br />Maju Sejahtera
      </span>
    </a>

    <nav aria-label={t.nav.label} class="order-3 w-full overflow-x-auto md:order-none md:w-auto">
      <ul class="flex items-center gap-6 whitespace-nowrap text-xs font-bold uppercase tracking-[0.12em]">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="border-b-2 border-transparent py-1 no-underline transition-colors hover:border-accent hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LanguageSwitcher locale={locale} />
  </div>
</header>
