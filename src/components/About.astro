---
import { copy } from '../data/copy';
import { site } from '../data/site';
---

<section id="about" class="border-b-2 border-ink bg-paper">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-8 sm:gap-10 lg:grid-cols-[0.3fr_0.7fr] lg:gap-16">
      <div class="reveal" data-reveal>
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
          {copy.about.overline}
        </p>
        <span class="mt-6 hidden font-display text-[clamp(5rem,14vw,10rem)] leading-[0.8] text-line sm:block" aria-hidden="true">
          01
        </span>
      </div>

      <div class="reveal" data-reveal>
        <h2 class="font-display text-[clamp(2.25rem,6vw,4.5rem)] uppercase leading-[1] tracking-[-0.03em]">
          {copy.about.title}
        </h2>

        <blockquote class="mt-6 border-l-4 border-accent pl-4 text-lg italic leading-[1.6] sm:mt-8 sm:pl-6 sm:text-xl">
          “{copy.about.quote}”
        </blockquote>

        <p class="mt-6 max-w-2xl text-base leading-[1.7] text-muted sm:mt-8 sm:text-lg">
          {copy.about.lead}
        </p>

        <div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2">
          <article class="border-2 border-line bg-surface p-6 transition-colors hover:border-ink">
            <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-accent">
              {copy.about.visionLabel}
            </h3>
            <p class="mt-3 text-sm leading-[1.7]">{copy.about.vision}</p>
          </article>
          <article class="border-2 border-line bg-surface p-6 transition-colors hover:border-ink">
            <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-accent">
              {copy.about.missionLabel}
            </h3>
            <p class="mt-3 text-sm leading-[1.7]">{copy.about.mission}</p>
          </article>
        </div>

        <div class="mt-8">
          <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
            {copy.about.suppliesLabel}
          </h3>
          <div class="mt-3 flex flex-wrap gap-3">
            <span class="border-2 border-ink px-4 py-2 font-mono text-xs uppercase">
              {copy.about.electrical}
            </span>
            <span class="border-2 border-ink px-4 py-2 font-mono text-xs uppercase">
              {copy.about.mechanical}
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-3 sm:mt-14 lg:grid-cols-[1.3fr_1fr]" data-reveal>
      <img
        src={site.aboutImages[0]}
        alt=""
        class="h-56 w-full border-2 border-ink object-cover grayscale transition-[filter] duration-200 hover:grayscale-0 sm:h-72 lg:h-[34rem]"
        loading="lazy"
      />
      <div class="grid grid-cols-2 gap-3">
        {
          site.aboutImages.slice(1).map((src) => (
            <img
              src={src}
              alt=""
              class="h-32 w-full border-2 border-ink object-cover grayscale transition-[filter] duration-200 hover:grayscale-0 sm:h-36 lg:h-[16.4rem]"
              loading="lazy"
            />
          ))
        }
        <div class="flex flex-col justify-between border-2 border-ink bg-ink p-5 font-mono text-[11px] uppercase tracking-[0.12em] text-paper">
          <span>Field notes</span>
          <span class="text-paper/60">{copy.about.stamp}</span>
          <span class="text-xl" aria-hidden="true">↗</span>
        </div>
      </div>
    </div>
  </div>
</section>
